# Ampoteket web frontend: safe placeholders only (never commit secrets).
# bun run development starts a local Convex backend and supplies all of these itself.
# The Convex deployment URL (production: https://<name>.convex.cloud).
PUBLIC_CONVEX_URL=http://127.0.0.1:54329
# Server-only (never PUBLIC_): Cloudflare secrets / .dev.vars, or .env.local for Vite.
# Shared with the deployment's CHECKOUT_SERVER_KEY; proves checkout calls come from the Worker.
# CHECKOUT_SERVER_KEY=
# Resend key for buyer receipt emails (also needs the RECEIPT_LIMIT binding).
# RESEND_API_KEY=
# Exact HTTPS origin for checkout POSTs; never inferred from Host.
# CHECKOUT_ALLOWED_ORIGIN=https://ampoteket.no
# Catalog, cart, checkout and its API stay closed ("coming soon") unless exactly true.
# bun run development sets it to true.
# SALES_OPEN=true
# Checkout also requires CHECKOUT_SESSION_LIMIT and CHECKOUT_OPERATION_LIMIT
# native bindings from wrangler.jsonc (also emulated by the adapter in Vite).
# Access checkout through the configured trusted HTTPS origin, not HTTP localhost.
