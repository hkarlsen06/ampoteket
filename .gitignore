# Ampoteket: filer som ikke skal spores i git
# Basert på docs/prosjektoversikt.md §3 (SvelteKit + Cloudflare Workers + Supabase),
# §6 (ingen hemmeligheter i repoet) og §8 (migrasjoner spores, lokal kjøring holdes utenfor).
#
# Hovedregel: versjoner kildekode, docs/, supabase/migrations/ og .env.example.
# Ignorer: avhengigheter, byggartefakter, lokale hemmeligheter, lokal Supabase-state,
# backup/data og OS/editor-filer.

# --- Avhengigheter (Node.js) ---
# Låst avhengighetsfil (package-lock.json / pnpm-lock.yaml / bun.lockb) SKAL spores, jf. §8.
node_modules/
.pnp/
.pnp.js
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# --- SvelteKit / Vite / TypeScript bygg ---
.svelte-kit/
build/
dist/
package/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# --- Cloudflare Workers / Wrangler (§3) ---
.wrangler/
.cloudflare/
.wrangler/state/
.dev.vars
.dev.vars.*
# wrangler.toml SKAL spores (inneholder ufarlig konfig), men lokale overrides skal ikke:
wrangler.local.toml

# --- Miljøvariabler og hemmeligheter (§6) ---
# Ingen hemmelige nøkler, service_role-nøkler eller databasepassord skal lagres i repoet.
# Bare .env.example med ufarlige eksempelverdier SKAL spores (§8).
.env
.env.*
!.env.example
!.env.test
*.pem
*.key
*.p12
*.pfx
secrets/
service-account*.json
supabase/.env

# --- Supabase lokalt (§8) ---
# config.toml, migrations/ og seed.sql SKAL spores. Lokal CLI-state skal ikke.
supabase/.branches/
supabase/.temp/
supabase/.timers/
supabase/.pooler/
supabase/storage/
supabase/postgres-data/
supabase/pgdata/

# --- Tester / coverage ---
.venv-proof/
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# --- Backup, dump og produksjonsdata (§10) ---
# Databasebackup og Storage-filer skal ikke inn i repoet. Syntetisk seed-data SKAL spores.
*.sql.gz
*.dump
*.backup
*.sqlite
*.sqlite-journal
*.db
dumps/
backups/
storage-downloads/
downloaded-storage/

# --- Genererte QR-koder / lokale bilder ---
# QR-eksempler som hører til docs kan spores, men lokalt genererte etiketter i bulk skal ikke.
qr-output/
labels/out/

# --- Logger ---
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.default
.idea/
*.swp
*.swo
*~
.project
.classpath

# --- Diverse lokale verktøy ---
.direnv/
.local-https/
.tool-versions.local
.vercel/
.netlify/

# --- Generated by `wrangler types` (bun run prepare) ---
worker-configuration.d.ts

# Python bytecode
__pycache__/

# --- Slopo (kode-duplikat-analyse, lokal state) ---
slopo.db
slopo-report/
slopo.agent.log
