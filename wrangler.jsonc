{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Local only; production is env.production below, so a deploy without --env
	// cannot replace the live Worker.
	"name": "ampoteket-local",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	// A deploy that names the live Worker without --env production keeps its vars
	// instead of wiping them. `wrangler versions upload` ignores this; see
	// docs/runbook-deploy.md §6 for the only supported deploy command.
	"keep_vars": true,
	"preview_urls": true,
	"ratelimits": [
		{ "name": "CHECKOUT_SESSION_LIMIT", "namespace_id": "4732201", "simple": { "limit": 20, "period": 60 } },
		{ "name": "CHECKOUT_OPERATION_LIMIT", "namespace_id": "4732202", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RECEIPT_LIMIT", "namespace_id": "4732204", "simple": { "limit": 3, "period": 60 } }
	],
	// Production, deployed only by `bun run deploy:production` (docs/runbook-deploy.md
	// §6). Kept out of the top level so
	// `vite dev` and `wrangler dev` never pick up hosted settings. Bindings are not
	// inherited, so the rate limits are repeated (same namespaces).
	"env": {
		"production": {
			"name": "ampoteket",
			// Persist errors without routine request logs or Auth callback query strings.
			"observability": {
				"enabled": true,
				"redact_query_string": true,
				"logs": { "invocation_logs": false }
			},
			"vars": {
				// The production Convex deployment. deploy:production refuses a deploy key for any other.
				// Set at cutover (docs/runbook-cutover.md); this placeholder matches no deployment.
				"PUBLIC_CONVEX_URL": "https://set-at-cutover.convex.cloud",
				"CHECKOUT_ALLOWED_ORIGIN": "https://ampoteket.no",
				// Exactly "true" opens buying (docs/website-guide.md §1.1).
				"SALES_OPEN": "false"
			},
			// www answers only to redirect to the apex (src/hooks.server.ts).
			"routes": [
				{ "pattern": "ampoteket.no", "custom_domain": true },
				{ "pattern": "www.ampoteket.no", "custom_domain": true }
			],
			"ratelimits": [
				{ "name": "CHECKOUT_SESSION_LIMIT", "namespace_id": "4732201", "simple": { "limit": 20, "period": 60 } },
				{ "name": "CHECKOUT_OPERATION_LIMIT", "namespace_id": "4732202", "simple": { "limit": 120, "period": 60 } },
				{ "name": "RECEIPT_LIMIT", "namespace_id": "4732204", "simple": { "limit": 3, "period": 60 } }
			]
		}
	},
	// Secrets (CHECKOUT_SERVER_KEY, RESEND_API_KEY) are never written here: use `wrangler secret put`
	// in production and `.dev.vars` locally. See docs/website-guide.md §1.1.
}
