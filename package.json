{
	"name": "ampoteket",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"development": "bun scripts/development.ts",
		"build": "vite build",
		"preview": "bun run build && wrangler dev --port 5174 --ip 0.0.0.0",
		"prepare": "svelte-kit sync && wrangler types",
		"i18n": "bun run scripts/i18n-editor.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:scripts": "svelte-kit sync && tsc --project tsconfig.scripts.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun run check:dashes && oxlint && eslint .",
		"check:dashes": "! git grep -nI '\u2014' -- ':!supabase/migrations' && ! git grep -nI ' - ' -- 'src/lib/i18n' && ! git grep -nIE ' [\u2013\u2014] ' -- src scripts docs '*.md' || (echo 'dash used as a sentence break; use a comma, colon or full stop' && exit 1)",
		"check:ink": "python3 scripts/check-clipped-ink.py",
		"test": "bun test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@gltf-transform/cli": "4.5.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "1.63.0",
		"@shadcn/lint": "^0.1.5",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/three": "0.186.0",
		"bits-ui": "^2.19.3",
		"bun-types": "^1.4.2",
		"cn": "^0.4.0",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"layerchart": "^2.5.0",
		"oxlint": "^1.86.0",
		"shadcn-svelte": "1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"wrangler": "^4.144.0"
	},
	"dependencies": {
		"@google/model-viewer": "4.3.1",
		"@pdf-lib/fontkit": "1.1.1",
		"@supabase/supabase-js": "2.117.2",
		"barcode-detector": "3.2.2",
		"lossless-json": "4.3.1",
		"pdf-lib": "1.17.1",
		"phosphor-svelte": "3.1.0",
		"three": "0.186.1",
		"zxing-wasm": "3.1.3"
	},
	"overrides": {
		"cookie": "0.7.2"
	},
	"patchedDependencies": {
		"@sveltejs/adapter-cloudflare@7.2.9": "patches/@sveltejs%2Fadapter-cloudflare@7.2.9.patch"
	}
}
