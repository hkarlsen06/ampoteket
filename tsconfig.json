{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		// Bun's test runner does not map `#lib/x.js` package imports to `x.ts`; this path does.
		"paths": { "#lib/*": ["./src/lib/*"] },
		"rewriteRelativeImportExtensions": true,
		// checkJs stays off: worker-configuration.d.ts imports the generated
		// `.svelte-kit/cloudflare/_worker.js`, and checking that build output
		// (477 spurious errors) drowns out real diagnostics. src is TS/Svelte only.
		"checkJs": false,
		"sourceMap": true,
		"strict": true,
		"types": [
			"./worker-configuration.d.ts",
			"bun-types",
			"$app/types"
		]
	},
	"include": ["src", "vite.config.ts"],
	"exclude": [
		"node_modules/**",
		".svelte-kit/output/**",
		".svelte-kit/cloudflare/**",
		"build/**",
		".wrangler/**",
		"supabase/**",
		"scripts/**"
	]
}
